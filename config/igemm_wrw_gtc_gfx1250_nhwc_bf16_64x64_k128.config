[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x128, row_stride addressing pilot
# First config to exercise the row_stride redesign (docs/gfx1250_wrw_addressing_redesign.md):
# gemm_k_per_block=128 > gemm_m_per_block=64, so the old num_col_groups scheme
# (num_col_groups = gemm_m_per_block // gemm_k_per_block, previously capped at
# gemm_k_per_block <= gemm_m_per_block -- see the _64x64_kmax config's docstring) no longer
# applies; each thread now owns row_stride=2 full K-rows instead of one row's
# column-fragment. Scope of this pilot: bf16, single group, no M/N/K-tail, no split-K,
# no TDM -- see igemm_wrw_gtc_wmma_nhwc_t.__init__'s row_stride asserts for what's
# deferred. tensor_a/b_thread_lengths' K-dim entry is bumped from 64 to 128 to match
# gemm_k_per_block (cluster_lengths/block_size unchanged, since gemm_m/n_per_block are
# still 64) -- mirrors the _64x64_kmax config's own [1, gemm_k_per_block, 1, 1] pattern.
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 128
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 128, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 128, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
