[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x4, correctness-first WMMA milestone
# gemm_k_per_block=4 here (not 32/64) since v_wmma_f32_16x16x4_f32 has K=4 -- see
# python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.

#########################################################################################
# Master config: every validated fwd/fp32 gfx1250 tunable combination from
# this project's individual mechanism config files, unioned into one file so a single
# conv_driver.exe build searches the FULL candidate set and reports the true fastest
# kernel per shape -- mirroring gfx950/942's single comprehensive per-direction/precision
# config file (see script/gen_gfx950_conv_split_kernel.sh). Generated by
# script/build_gfx1250_master_configs.py from 22 source files; re-run that
# script after adding a new gfx1250 config file to pick it up here too.
#########################################################################################

# --- from igemm_fwd_gtc_gfx1250_nhwc_fp32.config ---
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
# REQUIRED for correctness, not a perf knob -- see docs/gfx1250_fp32_wmma_occupancy_race.md.
# Single-buffered LDS with v_wmma_f32_16x16x4_f32 (this arch's only pure-fp32 WMMA form)
# produces silent wrong-answer results once enough workgroups are concurrently resident.
# Confirmed NOT a barrier/LDS-fence issue and NOT fixable by V_NOP or s_setprio spacing
# (both tested, both had zero effect). Affects fwd/bwd/wrw alike, both 64x64 and 128x128
# tiles alike -- do not remove this without re-validating at high (>~10k workgroup) scale.

#########################################################################################
#--------------------------- 64x64x4, small-tile coverage for non-128-aligned gemm_m/gemm_n
# See igemm_fwd_gtc_gfx1250_nhwc_fp16.config's 64x64 section for the full derivation.
# gemm_k_per_block=4 since v_wmma_f32_16x16x4_f32 has K=4.

# --- from igemm_fwd_gtc_gfx1250_nhwc_fp32.config ---
[igemm_fwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
# REQUIRED for correctness -- see the 128x128 section above and
# docs/gfx1250_fp32_wmma_occupancy_race.md. Smaller tiles allow higher occupancy per WGP,
# so this hits the failure threshold at a smaller workgroup count than 128x128 does.

# --- from igemm_fwd_gtc_gfx1250_nhwc_fp32_128x64.config ---
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 64
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 2]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1

