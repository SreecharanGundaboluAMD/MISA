# Phase 27: wmma_acc_bf16=1 + local_prefetch_num=2 together, mirroring
# igemm_fwd_gtc_gfx1250_nhwc_fp16_k2x_f16acc_lp2.config (Phase 24) exactly. Phase 24 found
# this combination REGRESSES for fp16 despite fitting the VGPR budget -- shipped here purely
# to get the same data point for bf16, not as a recommended config. See
# docs/gfx1250_wmma_layout.md's Phase 27.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x64, k-sub-loop + BF16-accumulate + VGPR-level prefetch
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_bf16            = 1
local_prefetch_num       = 2
