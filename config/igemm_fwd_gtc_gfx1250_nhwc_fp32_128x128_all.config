tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
direct_store              = 1
gemm_k_global_split       = 1
wmma_setprio              = 1
local_prefetch_num        = 1
ds_load_tr_b              = 0
wmma_l2_prefetch          = 1
