gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
tdm_global_load           = 1
wmma_setprio              = 1
local_prefetch_num        = 1
ds_load_tr_b              = 0
# REQUIRED for correctness, not a perf knob -- see docs/gfx1250_fp32_wmma_occupancy_race.md.
# Single-buffered LDS with v_wmma_f32_16x16x4_f32 (this arch's only pure-fp32 WMMA form)
# produces silent wrong-answer results once enough workgroups are concurrently resident.
# Confirmed NOT a barrier/LDS-fence issue and NOT fixable by V_NOP or s_setprio spacing
# (both tested, both had zero effect). Affects fwd/bwd/wrw alike, both 64x64 and 128x128
# tiles alike -- do not remove this without re-validating at high (>~10k workgroup) scale.
