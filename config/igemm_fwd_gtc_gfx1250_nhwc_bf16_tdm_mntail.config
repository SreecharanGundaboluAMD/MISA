[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, TDM + GEMM_M/N tail combined (bf16)
# bf16 sibling of igemm_fwd_gtc_gfx1250_nhwc_fp16_tdm_mntail.config -- see that file and
# docs/gfx1250_wmma_layout.md's Phase 37 for the mechanism (TDM's own hardware OOB, not
# EXEC-masking, covers M/N tail here). Precision-generic code, hardware-spot-checked on
# bf16 during Phase 37 development.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
tdm_global_load          = 1
wmma_m_tail              = 1
wmma_n_tail              = 1
