[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x256x32, Phase 68 (2026-09-02, PERF-002) GEMM_M tail ---
# Same tile as `_256x256.config` (see that file's header for the full Phase 52/53/54
# chunked-epilogue + VGPR-MSB derivation) with wmma_m_tail=1 added -- lets this macro-tile
# dispatch on shapes whose gemm_m (= n*ho*wo for fwd's NHWC layout) is NOT an exact
# multiple of 256, e.g. n128 c2048 h7w7 k2048 (gemm_m=128*7*7=6272, 6272%256=128), which
# was previously REJECTED outright by tunable_is_valid() -- no 256x256/256x128 tunable
# could ever be selected for it. Kept in its own file (not merged into `_256x256.config`'s
# section) since wmma_m_tail IS folded into the kernel name (see
# igemm_gtc_encode_kernel_name/igemm_gtc_base.h's `_mtail` suffix), so the two sections
# coexist in the master `_all.config` without colliding, but are organized as separate
# single-mechanism files per this project's own convention (see e.g. `_mtail.config` vs.
# the base `.config` at 128x128).
#
# wmma_m_tail composes with wmma_epilogue_chunked/wmma_acc_high_bank with NO further code
# changes for wmma_acc_high_bank (its masked slow-path store only ever touches bank-0
# scratch registers, confirmed by inspection and hardware validation) and required genuine
# new EXEC-mask-guard plumbing in `_emit_chunked_non_atomic_store`'s gather loop for
# wmma_epilogue_chunked (mirroring the unchunked gather's v_cmpx guards, adapted to
# recompute the absolute row fresh every pass from `v_tid` instead of carrying it forward,
# since chunked addressing itself already works that way -- see
# coalescing_store_wmma.py's docstring). Hardware-validated (-V 1, valid:y) on the exact
# shape above and on the master `_256x256.config`'s three previously-passing divisible
# shapes (unaffected -- same cost, e.g. n128 c1024 h14w14 k1024 unchanged at ~0.106ms).
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 256
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 8
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 256]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 256]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
wmma_m_tail              = 1
