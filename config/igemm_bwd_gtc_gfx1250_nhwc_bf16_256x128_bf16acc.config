[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x128x32, packed-accumulate variant (Phase 56) -- bwd's
# version of the fwd 256x256 entry's packed-accumulate sibling (see
# `igemm_fwd_gtc_gfx1250_nhwc_bf16_256x256_bf16acc.config`'s comment for the full
# derivation and rationale). ~5% faster than the plain (full F32) 256x128 entry in
# same-run comparisons, still behind the existing 128x128 kernel. Kept as a separate
# opt-in config file, not unioned into the master _all.config, for the same
# ACCUMULATE_WIDTH_KEYS reason as every other `*_bf16acc.config` in this repo. See
# docs/gfx1250_wmma_vgpr_msb_wip_status.md's Phase 56 for the full investigation.
[igemm_bwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 8
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 2]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_bf16            = 1
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
