[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, Phase 13: global_load_async_to_lds_b128
# Identical to the 128x128 config in igemm_fwd_gtc_gfx1250_nhwc_fp16.config except
# async_global_load=1: A and B use global_load_async_to_lds_b128 directly (no VGPR
# staging buffer, no separate LDS-store step) instead of global_load_dwordx4 +
# ds_write_b128. Kept in a separate file (matching the existing _k2x/_dbuf convention)
# since the kernel-name encoder doesn't fold this new tunable into the mangled symbol
# name, and the same 128x128x32/fp16 shape parameters would otherwise collide with the
# existing non-async kernel of the same name. See docs/gfx1250_wmma_layout.md's Phase 13.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
async_global_load        = 1
