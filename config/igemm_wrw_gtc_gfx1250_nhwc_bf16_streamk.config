[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, wrw_streamk (Phase 58) -- persistent-kernel
# proof of mechanism, see docs/gfx1250_streamk_design.md. Keeps grid.x/grid.y (tile
# assignment) exactly like the plain _gsplit config; replaces the fixed grid.z==split-count
# design with a small, occupancy-sized persistent grid.z whose workgroups dynamically
# claim K-shards (one gemm_k_per_block each) from a per-(bx,by) atomic counter in a bounded
# loop, instead of the driver's ternary search picking a static split count up front. Only
# nxe==0 (single-tap) supported so far -- see python/igemm/igemm_wrw_gtc_wmma_nhwc.py's
# emit_kernel_streamk_loop() docstring. Hardware-validated: single-shard, exact-multiple
# multi-claim (e.g. 512 shards / 64 persistent workers = 8 claims each), and
# non-exact-multiple multi-claim (tail) cases all pass. Kept as an opt-in-only config
# (not folded into the master config union yet) pending a real performance comparison
# against the existing _gsplit ternary-search design on a confirmed-idle GPU.
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
gemm_k_global_split      = 1
wrw_streamk              = 1
