# Phase 22 (VGPR-level prefetch): local_prefetch_num=2 on top of the k-sub-loop (k2x)
# config -- doubles num_vgpr_accumulate_a/b (wmma_repeat_m/n * inst_wmma.num_v_a/b * 2).
# fp32's num_v_a=num_v_b=2, so this costs only +16 VGPRs total at 128x128 -- fits easily,
# unlike fp16/bf16/int8 (num_v_a=num_v_b=8, +64 total, no headroom -- see
# docs/gfx1250_wmma_layout.md's Phase 22 VGPR-budget section). See
# python/operations/wmma_main_loop.py's local_prefetch_num docstring.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, k-sub-loop + VGPR-level prefetch
# python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
local_prefetch_num       = 2
lds_double_buffer        = 1
