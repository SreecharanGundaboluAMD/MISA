[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x128x32, EXISTING wr8x4-w4 row, ported to fwd ----------
# Comparison baseline for the NEW wr4x4-w8 row (see the _wr4x4w8.config sibling file):
# this is the EXISTING ctrl_wmma_mapping_table 'bf16' 256x128 entry (4 waves,
# wave_repeat_m=8/wave_repeat_n=4, total_acc_c=256 -- requires wmma_acc_high_bank=1) --
# previously only ported to bwd (igemm_bwd_gtc_gfx1250_nhwc_bf16_256x128.config); fwd's
# row_repeat_a/b mechanism is already fully generic, so this is a straight direction
# port with zero mechanism changes, purely for an apples-to-apples fwd-vs-fwd VGPR/perf
# comparison against the new wr4x4-w8/col_split_b row.
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 8
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 2]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
