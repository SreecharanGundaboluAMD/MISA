# Stacks lds_row_pad=16 (LDS bank-conflict padding) with lds_double_buffer=1 (cross-tile
# load/compute overlap via wmma_main_loop.py's can_hoist path) in the same section. These
# are different mechanisms (bank-conflict-free row stride vs. double-buffered LDS +
# hoisted next-tile load) with no known interaction -- can_hoist's gating has no
# dependency on row pitch. Never previously combined in one shipped section anywhere in
# this repo (see docs/gfx1250_wmma_perf_report_v2.md §5 P0.5) -- this file exists to
# hardware-validate correctness and measure whether the two effects are additive.
# Folded into kernel name as "_dbuf_ldsrp" (dbuf ordered first per
# igemm_gtc_encode_kernel_name's fixed suffix order).
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, correctness-first WMMA milestone
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. See python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
lds_row_pad              = 16

#########################################################################################
#--------------------------- 64x64x32, small-tile coverage for non-128-aligned gemm_m/gemm_n
# Same 1x1/stride1/no-pad (nxe=0) restriction as the 128x128 config above -- see
# igemm_fwd_gtc_gfx1250_nhwc_fp16_ldsrp.config's 64x64 section comment for the
# block_size=64 asymmetric-wave-grid derivation.
[igemm_fwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
lds_row_pad              = 16
