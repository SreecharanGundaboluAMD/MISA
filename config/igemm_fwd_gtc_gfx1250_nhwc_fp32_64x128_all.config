[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
# Master config: all valid tunable combos for fwd/fp32 64x128x4
# Generated by script/generate_all_configs.py
# 80 combinatorial variants
#########################################################################################

# --- 64x128x4 +local_prefetch_num ---
