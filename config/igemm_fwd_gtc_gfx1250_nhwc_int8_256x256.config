[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x256x64, PERF-003 extension (2026-09-02) ---------------
# Mechanical port of igemm_fwd_gtc_gfx1250_nhwc_bf16_256x256.config's 256x256 entry --
# v_wmma_i32_16x16x64_iu8 has num_v_c=8, identical to v_wmma_f32_16x16x32_bf16's
# accumulator width (only num_v_a/num_v_b=8 -- same as bf16 too, it turns out -- and
# K=64 differ, and those are already fully parameterized via inst_wmma), so this table
# row (see python/operations/wmma_mapping.py's 'int8' entries) needs the exact same
# wmma_acc_high_bank=1 (VGPR-MSB, total_acc_c=256 fits the ceiling exactly) and
# wmma_epilogue_chunked=1 (a 256x256 tile needs 262144 bytes of LDS to stage one-shot,
# 4x the 64KB ceiling) as bf16's identical shape. Neither assert (igemm_base.py's
# wmma_epilogue_chunked/wmma_acc_high_bank blocks, ~lines 774-813) is precision-gated --
# only direction/tail/atomic-split gated -- so int8 passes them unchanged. Only supports
# the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a plain GEMM,
# matching this project's other correctness-first WMMA milestones. gemm_k_per_block=64
# (not 32) since v_wmma_i32_16x16x64_iu8 has K=64.
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 256
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 8
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 256]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 256]
direction                = "fwd"
precision                = "int8"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
