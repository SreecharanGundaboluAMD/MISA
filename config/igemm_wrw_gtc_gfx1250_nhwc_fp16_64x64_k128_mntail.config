[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x128, row_stride addressing + M/N-tail
# identical to igemm_wrw_gtc_gfx1250_nhwc_fp16_64x64_k128.config except wmma_m_tail=1,
# wmma_n_tail=1. Exercises the new broadcast per-sub_chunk M/N-tail flags (uniform across
# lanes, since every thread loads the same full-width row when row_stride>1) combined via
# _emit_gld_chunk_load's v_flag_col -- see docs/gfx1250_wrw_addressing_redesign.md.
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 128
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 128, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 128, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_m_tail              = 1
wmma_n_tail              = 1
