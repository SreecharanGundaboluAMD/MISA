[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, Phase 26b GEMM_N tail
# Same tile shape as the base bf16 config's 128x128 section, with wmma_n_tail=1: relaxes
# the driver's exact-multiple-of-gemm_n_per_block requirement and EXEC-masks the B-operand
# load plus a second epilogue guard for out-of-range columns. See
# docs/gfx1250_wmma_layout.md's Phase 26b.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_n_tail              = 1

direct_store             = 1
