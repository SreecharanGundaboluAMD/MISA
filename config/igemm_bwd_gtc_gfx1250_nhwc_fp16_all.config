[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
# Combined master config for bwd/fp16
# Generated by script/generate_all_configs.py
# Per-tile-shape variants also available as:
#   igemm_bwd_gtc_gfx1250_nhwc_fp16_32x32_all.config
#   igemm_bwd_gtc_gfx1250_nhwc_fp16_64x64_all.config
#   igemm_bwd_gtc_gfx1250_nhwc_fp16_128x128_all.config
#########################################################################################

# --- 32x32x32 +local_prefetch_num ---
[igemm_bwd_gtc]
gemm_m_per_block         = 32
gemm_n_per_block         = 32
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 2
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 32]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 32]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
local_prefetch_num        = 1

