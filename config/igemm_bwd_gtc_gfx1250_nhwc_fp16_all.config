[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, correctness-first WMMA milestone
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. See python/igemm/igemm_bwd_gtc_wmma_nhwc.py for the full explanation.

#########################################################################################
# Master config: every validated bwd/fp16 gfx1250 tunable combination from
# this project's individual mechanism config files, unioned into one file so a single
# conv_driver.exe build searches the FULL candidate set and reports the true fastest
# kernel per shape -- mirroring gfx950/942's single comprehensive per-direction/precision
# config file (see script/gen_gfx950_conv_split_kernel.sh). Generated by
# script/build_gfx1250_master_configs.py from 22 source files; re-run that
# script after adding a new gfx1250 config file to pick it up here too.
#
# NOT included: 2 accumulate-width-variant section(s) (wmma_acc_f16) from igemm_bwd_gtc_gfx1250_nhwc_fp16_k2x_f16acc.config, igemm_bwd_gtc_gfx1250_nhwc_fp16_k2x_f16acc_lp2.config -- conv_driver.cpp computes
# is_wmma_f16_acc/is_wmma_bf16_acc/is_wmma_atomic_pack_bf16 ONCE from tunables[0],
# not per-tunable, so mixing a different output-buffer-width kernel into this file
# would silently corrupt verification for it (confirmed: passes standalone, fails
# here). These remain usable via their own individual config files.
#########################################################################################

# --- from igemm_bwd_gtc_gfx1250_nhwc_fp16.config ---
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0

#########################################################################################
#--------------------------- 64x64x32, small-tile coverage for non-128-aligned gemm_m/gemm_n
# Ported from igemm_fwd_gtc_gfx1250_nhwc_fp16.config's 64x64 section -- see that file's
# comment for the full derivation (block_size=64 via asymmetric wave grid
# waves_per_m=2/waves_per_n=1, since wave_tile is fixed at 16 and a 64x64 macro tile can't
# reach block_size=64 any other way).

# --- from igemm_bwd_gtc_gfx1250_nhwc_fp16.config ---
[igemm_bwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0

# --- from igemm_bwd_gtc_gfx1250_nhwc_fp16_32x32.config ---
[igemm_bwd_gtc]
gemm_m_per_block         = 32
gemm_n_per_block         = 32
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 2
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 32]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 32]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0

# --- from igemm_bwd_gtc_gfx1250_nhwc_fp16_async.config ---
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
