[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

# 256x128x32, chunked epilogue + async output store (Phase 69).
# fp16 version of the 256x128 chunked config, with wmma_async_store=1.
# Tests the LDS-reuse hazard: the chunked epilogue reuses a small LDS region across
# wave_repeat_m=8 groups, and each group's async store reads from that LDS region.
# s_wait_asynccnt 0x0 before each inter-group barrier ensures the previous group's
# async stores complete before the next group's scatter overwrites the LDS bytes.
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 8
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 2]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
wmma_async_store         = 1
