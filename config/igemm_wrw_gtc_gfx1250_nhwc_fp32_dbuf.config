# Phase 2 (LDS double-buffering): lds_double_buffer=1 doubles the LDS allocation and
# enables the ping-pong buffer switch in wmma_main_loop.py. See docs/gfx1250_wmma_layout.md.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x4, correctness-first WMMA milestone
# gemm_k_per_block=4 here (not 32/64) since v_wmma_f32_16x16x4_f32 has K=4 -- see
# python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
