[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x64x32, first asymmetric tile shape (2026-08-25)
# Targets the case only one of gemm_m/gemm_n is missing 128-alignment (the original
# motivating case for tile-shape diversity, more precisely than the symmetric 64x64 shape).
# waves_per_m=2 (128/(4*16)), waves_per_n=1 (64/(4*16)), waves=2 -> block_size=64. Since
# block_size(64) == gemm_n_per_block(64) already, B needs zero changes (identical to the
# square-tile code path). block_size(64) < gemm_m_per_block(128), so A's global-load uses
# the new row_repeat_a=gemm_m_per_block/block_size=2 generalization (each thread owns 2
# global rows, strided by block_size) -- see igemm_fwd_gtc_wmma_nhwc.py's __init__ and
# global_load_a_functor/shared_store_a_functor docstrings for the full mechanism.
# tensor_a_thread_lengths=[1,32,1,2]/tensor_a_cluster_lengths=[1,1,1,64]: NOT read by the
# WMMA kernel's address generation (row_repeat_a is derived independently from
# gemm_m_per_block//block_size) -- these values only need to satisfy igemm_base.py's
# generic validation asserts (product(cluster)==block_size, product(thread)*block_size==
# gemm_m_per_block*gemm_k_per_block), same as every other WMMA config's dead-weight fields.
# async_global_load intentionally omitted (defaults to 0) -- row_repeat_a is not yet
# combined with Phase 13's async load path.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 2]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
