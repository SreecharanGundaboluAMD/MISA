# Phase 15 (main-loop interleaving, bwd port): gemm_k_per_block = 64 = 32*2 (Phase 1's
# k-sub-loop, required -- interleaving needs num_k_substeps > 1 to have anything to
# interleave), plus main_loop_interleave=1. A (grad_output, untransposed) interleaves;
# B (weight, transposed) stays on the deferred bulk path. See wmma_main_loop.py's
# ctrl.interleave_a/b docstring and docs/gfx1250_wmma_layout.md's Phase 15 section.
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. See python/igemm/igemm_bwd_gtc_wmma_nhwc.py for the full explanation.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x64, main-loop interleaving variant (see banner above)
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
main_loop_interleave     = 1
