[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x256x32, Phase 53 chunked epilogue + BF16-accumulate --
# closes (part of) the tile-size gap vs. gfx950's own XDLOPS kernels (this same project's
# generator, just for CDNA4) found in Phase 52: gfx950 configs use macro-tiles up to
# 256x256, made possible by a grouped/chunked epilogue LDS-reuse design gfx1250's WMMA
# path never adopted until now. waves_per_m=4,waves_per_n=2 (waves=8, block_size=256),
# wave_repeat_m=4 (unchanged from the working 128x128 entry), wave_repeat_n=8 --
# specifically choosing block_size(256) == macro_tile_m == macro_tile_n exactly, so
# row_repeat_a/b are both 1 (no row-repeat needed at all, the simplest case, matching the
# working 128x128 entry's own "block_size==macro_tile" simplicity -- just more waves).
#
# wmma_acc_bf16=1 is REQUIRED here, not optional: gfx1250's real, hardware-verified
# 256-VGPR/wave ceiling (confirmed directly -- this project's largest existing kernel,
# int8 128x128, already runs at exactly v_end=256) means a 256x256 tile's F32-accumulate
# footprint (total_acc_c = 256*256/256 = 256 registers) alone would already exceed the
# entire per-wave budget before counting ANY other overhead (a real build failure,
# confirmed directly: v_end=707 with f32 accumulate). BF16-accumulate halves it to 128,
# matching the existing 128x128 F32 entry's own accumulator size exactly. See
# docs/gfx1250_wmma_layout.md's Phase 52/53 for the full derivation, including the
# separately-scoped VGPR-MSB (S_SET_VGPR_MSB, up to 1024 VGPRs) mechanism this ISA
# genuinely supports but this project's codegen doesn't yet use -- that would remove the
# precision tradeoff entirely, but needs its own llvm-mc verification and
# register-allocator work, out of scope here.
#
# Requires wmma_epilogue_chunked=1 -- the non-atomic epilogue would otherwise need the
# full 256*256*2(bf16acc elem width)=131072 bytes of LDS to stage the whole output tile
# at once (2x the 64KB/workgroup hardware limit even at the narrower accumulate width).
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM, matching this project's other correctness-first WMMA milestones.
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 256
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 8
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 256]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 256]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_bf16            = 1
wmma_epilogue_chunked    = 1
