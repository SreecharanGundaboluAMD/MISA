[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x256x32, Phase 53 chunked epilogue + Phase 54 VGPR-MSB --
# closes (part of) the tile-size gap vs. gfx950's own XDLOPS kernels (this same project's
# generator, just for CDNA4) found in Phase 52: gfx950 configs use macro-tiles up to
# 256x256, made possible by a grouped/chunked epilogue LDS-reuse design gfx1250's WMMA
# path never adopted until now. waves_per_m=4,waves_per_n=2 (waves=8, block_size=256),
# wave_repeat_m=4 (unchanged from the working 128x128 entry), wave_repeat_n=8 --
# specifically choosing block_size(256) == macro_tile_m == macro_tile_n exactly, so
# row_repeat_a/b are both 1 (no row-repeat needed at all, the simplest case, matching the
# working 128x128 entry's own "block_size==macro_tile" simplicity -- just more waves).
#
# wmma_acc_high_bank=1 (not wmma_acc_bf16): Phase 53's first attempt tried BF16-accumulate
# to fit inside the 256-VGPR/wave ceiling and it STILL didn't fit (284 registers needed,
# 28 over, even with the halved accumulator) -- this tile was genuinely unreachable at
# any precision until Phase 54 (VGPR-MSB, S_SET_VGPR_MSB) moved v_c into a second,
# independently-addressed register bank. With v_c in bank 1, full F32 accumulate
# (total_acc_c = wave_repeat_m*wave_repeat_n*8 = 256 registers) fits easily (bank 1 has
# room for up to ~768 more), and bank 0 only needs ~156 registers for everything else --
# so this uses full F32 accumulation, matching this project's stated preference
# elsewhere (avoiding CK's documented bf16-atomic accumulate correctness bug) instead of
# the precision-losing packed workaround. See docs/gfx1250_wmma_layout.md's Phase 52/53
# for the original derivation and docs/gfx1250_wmma_vgpr_msb_wip_status.md for Phase 54's
# fix (a coalescing_store_wmma.py addressing bug, unrelated to tile size, found and fixed
# on the 128x128 mechanism-only test before this config was revisited).
#
# Requires wmma_epilogue_chunked=1 -- the non-atomic epilogue would otherwise need the
# full 256*256*4(f32 accumulate)=262144 bytes of LDS to stage the whole output tile at
# once (4x the 64KB/workgroup hardware limit). Only supports the degenerate case: 1x1
# filter, stride 1, no padding (nxe=0), i.e. a plain GEMM, matching this project's other
# correctness-first WMMA milestones.
#
# Multi-workgroup note: an earlier version of `wmma_epilogue_chunked` had a real,
# pre-existing bug (unrelated to VGPR-MSB or this tile size -- reproduced at the
# original 128x128 tile too) where the chunked scatter's compact-row derivation used
# `v_gemm_im` directly without masking out the block-offset the prologue permanently
# folds into it, corrupting addressing for every workgroup after the first. Fixed in
# `coalescing_store_wmma.py`'s `_emit_chunked_non_atomic_store` (mask to tile-local
# range before deriving wave_idx) -- hardware-validated `valid:y` across single- and
# multi-workgroup problems, multi-K-block, and multi-N-block. See
# docs/gfx1250_wmma_vgpr_msb_wip_status.md's Phase 55 for the full investigation.
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 256
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 8
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 256]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 256]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
