[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, correctness-first WMMA milestone
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. See python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0

direct_store             = 1

#########################################################################################
#--------------------------- 64x64x32, small-tile coverage for non-128-aligned gemm_m/gemm_n
# Same 1x1/stride1/no-pad (nxe=0) restriction as the 128x128 config above -- this is purely a
# smaller macro-tile variant for problem shapes whose gemm_m/gemm_n divide evenly into 64 but
# not 128 (e.g. n*ho*wo or k/group not landing on a multiple of 128).
# block_size=64 (not 128!): the global-load thread mapping uses v_tid directly as the
# per-thread gemm_m/n row index, which requires block_size == gemm_m_per_block ==
# gemm_n_per_block exactly. With wave_tile fixed at 16, a 64x64 macro tile can only reach
# block_size=64 via an asymmetric wave grid (waves_per_m=2, waves_per_n=1), hence the
# asymmetric wmma_repeat_m=2 / wmma_repeat_n=4 below (both still produce a 64x64 output tile:
# 16*2*2=64 for M, 16*4*1=64 for N) -- see python/operations/wmma_mapping.py's table comment
# for the full derivation.
[igemm_fwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0


direct_store             = 1
