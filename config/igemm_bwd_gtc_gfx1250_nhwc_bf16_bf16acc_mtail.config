[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, Phase 27 validation: bf16acc unblocks 128x128 M-tail
# The whole point of Phase 27: bwd's plain 128x128 tile is exactly 256/256 VGPRs (zero
# margin), which is why Phase 26a's wmma_m_tail (needing 1 extra VGPR for v_m_tail_row)
# could only ship 64x64 for bwd. wmma_acc_bf16 halves v_c (128->64), freeing enough headroom
# for wmma_m_tail's extra register to fit at 128x128 too. See
# docs/gfx1250_wmma_layout.md's Phase 27.
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_bf16            = 1
wmma_m_tail              = 1
