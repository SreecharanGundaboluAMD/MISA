# Phase 24: wmma_acc_f16=1 + local_prefetch_num=2 together -- the actual target combination.
# VGPR arithmetic: v_c halves 128->64 (f16acc), v_a/v_b double 32+32->64+64 (lp2), landing at
# 188+64=252 -- exactly the pre-existing 252/256 ceiling this branch already proved workable
# for fp32 (Phase 22), now reachable for fp16 too. See docs/gfx1250_wmma_layout.md's Phase 24.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x64, k-sub-loop + F16-accumulate + VGPR-level prefetch
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_f16             = 1
local_prefetch_num       = 2
