[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x256, row_stride addressing (K=256, row_stride=4)
# Extends the 64x64x128 row_stride pilot (bf16_64x64_k128.config) to row_stride=4. Same
# code path (docs/gfx1250_wrw_addressing_redesign.md), same scope notes as that config --
# except M/N/K-tail are now supported too (see igemm_wrw_gtc_wmma_nhwc_t's row_stride>1
# tail handling). Still bf16, single group, no split-K/streamk/TDM.
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 256
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 256, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 256, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
