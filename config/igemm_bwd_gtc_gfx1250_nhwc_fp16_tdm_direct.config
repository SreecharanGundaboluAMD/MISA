[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, Phase 42: TDM-based A/B-operand load for bwd
# Identical to the 128x128 config in igemm_bwd_gtc_gfx1250_nhwc_fp16.config except
# tdm_global_load=1 -- uses tensor_load_to_lds (the dedicated TDM hardware unit) for BOTH
# operands instead of the VGPR-staged path, and skips bwd's per-tap division-based gather
# entirely (see igemm_bwd_gtc_wmma_nhwc.py's emit_kernel_tap_loop). 1x1-conv-only (nxe=0).
# Measured trade-off (see docs/gfx1250_wmma_layout.md's Phase 42): faster for small-to-
# moderate GEMM_K depths (removes the one-time division-gather cost), slower for very
# large GEMM_K (the per-iteration TDM descriptor rebuild's fixed cost accumulates past
# where the one-time savings pay for it) -- not a strict win, use per-shape.
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
tdm_global_load          = 1

direct_store             = 1
