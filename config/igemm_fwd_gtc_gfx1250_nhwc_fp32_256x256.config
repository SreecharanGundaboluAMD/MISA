[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x256x4, PERF-003 extension (2026-09-02) ----------------
# Mechanical port of igemm_fwd_gtc_gfx1250_nhwc_bf16_256x256.config's 256x256 entry --
# v_wmma_f32_16x16x4_f32 has num_v_c=8, identical to v_wmma_f32_16x16x32_bf16's
# accumulator width (only num_v_a=num_v_b=2 -- no packing at all -- and K=4 differ, and
# those are already fully parameterized via inst_wmma), so this table row (see
# python/operations/wmma_mapping.py's 'fp32' entries) needs the exact same
# wmma_acc_high_bank=1 (VGPR-MSB, total_acc_c=256 fits the ceiling exactly) and
# wmma_epilogue_chunked=1 as bf16's identical shape. Neither assert (igemm_base.py's
# wmma_epilogue_chunked/wmma_acc_high_bank blocks, ~lines 774-813) is precision-gated,
# so fp32 passes them unchanged. lds_double_buffer=1 is REQUIRED for fp32 WMMA
# correctness regardless of tile size -- see igemm_fwd_gtc_gfx1250_nhwc_fp32_128x128_all
# .config's identical note and docs/gfx1250_fp32_wmma_occupancy_race.md. Only supports
# the degenerate case: 1x1 filter, stride 1, no padding (nxe=0). gemm_k_per_block=4
# since v_wmma_f32_16x16x4_f32 has K=4.
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 256
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 8
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 256]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 256]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
