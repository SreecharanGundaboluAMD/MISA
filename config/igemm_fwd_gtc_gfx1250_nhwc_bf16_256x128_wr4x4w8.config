[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x128x64, Phase 69 (2026-09-02, item #6) ----------------
# NEW mapping-table row (see python/operations/wmma_mapping.py's second 'bf16' 256x128
# entry): 8 waves, wave_repeat_m=4/wave_repeat_n=4 (NOT the existing wr8x4-w4 256x128
# row's 4 waves/8x4 repeat). waves_per_m=4 (256/(16*4)), waves_per_n=2 (128/(16*4)),
# block_size=8*32=256. block_size(256) > gemm_n_per_block(128) -- the INVERSE of every
# other row_repeat_a/b entry in this table (which all keep block_size <= both per-block
# dims). Two threads now cooperate on the SAME output column, each loading HALF of
# gemm_k_per_block (col_split_b=2, new mechanism -- see
# igemm_fwd_gtc_wmma_nhwc.py's __init__/_emit_lds_offset_setup/emit_kernel_prologue).
# tensor_b_cluster_lengths=[1,2,1,128] encodes this: dim1=2 is col_split_b (k_group),
# dim3=128 is gemm_n_per_block (n_idx) -- product=256=block_size. tensor_b_thread_lengths
# =[1,32,1,1]: each thread only loads gemm_k_per_block/col_split_b=32 elements (not the
# full 64), matching gemm_k_per_block=64 (2 wmma.k=32 substeps) here, not 32 -- col_split_b
# needs num_k_chunks(=gemm_k_per_block/inst.k=2) to be a multiple of col_split_b(2), so
# each thread issues exactly num_k_chunks_b=1 chunk.
#
# total_acc_c = wave_repeat_m*wave_repeat_n*8 = 128 -- HALF of the existing wr8x4-w4
# 256x128 row's 256, so this shape does NOT need wmma_acc_high_bank (fits the plain
# 0-255 VGPR range directly). Still needs wmma_epilogue_chunked=1 (a 256x128 tile's
# one-shot epilogue LDS is 256*128*4=131072 bytes regardless of accumulator width, over
# the 64KB ceiling) -- chunked epilogue is orthogonal to accumulator bank placement
# (coalescing_store_wmma.py's chunked path already branches on
# ctrl.vgpr_msb_tracker is not None, a no-op when wmma_acc_high_bank=0).
#
# col_split_b has NO tail-masking, no async/saddr/tdm global-load, no
# main_loop_interleave, and NO lds_double_buffer support yet (v_sst_os_b is a
# genuinely separate register from v_sst_a_os, and wmma_main_loop.py's double-buffer
# switch only knows how to toggle v_sst_a_os -- see that file's emit_buffer_switch and
# igemm_fwd_gtc_wmma_nhwc.py's col_split_b assert) -- exact-divisibility, single-
# buffered, fwd-only (bwd/wrw would need the same B-side plumbing ported first).
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 256]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 2, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_epilogue_chunked    = 1
