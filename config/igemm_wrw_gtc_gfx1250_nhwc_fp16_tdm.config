[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, Phase 45: TDM-based A/B-operand load for wrw
# Identical to the 128x128 config in igemm_wrw_gtc_gfx1250_nhwc_fp16.config except
# tdm_global_load=1 -- uses tensor_load_to_lds (the dedicated TDM hardware unit) for BOTH
# operands instead of the VGPR-staged path, and skips wrw's per-tap B gather entirely
# (see igemm_wrw_gtc_wmma_nhwc.py's global_load_b_functor). Unlike bwd (Phase 42), wrw's
# GEMM_K axis (n*ho*wo, spatial) is the ROW axis for BOTH A (grad_output) and B (input),
# so both operands need the same axis-swapped descriptor layout -- see
# docs/gfx1250_wmma_layout.md's Phase 45. 1x1-conv-only (nxe=0).
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
tdm_global_load          = 1

#########################################################################################
#--------------------------- 128x128x32, Phase 45: TDM + gemm_k_global_split
# Split-K aware: s_gemm_k_wg_off (this shard's K-slice base) and s_knum (this shard's own
# K-length) are already generic per-shard fields, reused unchanged for the TDM descriptors'
# global_addr and tensor_dim1 initialization -- see _emit_tdm_descriptor_setup_a/b.
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
tdm_global_load          = 1
gemm_k_global_split      = 1
