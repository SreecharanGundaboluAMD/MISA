# Phase 27: wmma_acc_bf16=1 -- v_wmma_bf16_16x16x32_bf16 (BF16-accumulate) instead of
# v_wmma_f32_16x16x32_bf16 (F32-accumulate), halving num_v_c (8->4) and v_c's VGPR footprint
# (128->64 for this 128x128 tile). Mirrors igemm_fwd_gtc_gfx1250_nhwc_fp16_k2x_f16acc.config
# (Phase 24) exactly. See docs/gfx1250_wmma_layout.md's Phase 27.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x64, k-sub-loop + BF16-accumulate
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_bf16            = 1
