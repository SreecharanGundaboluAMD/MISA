[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x4, GEMM_N tail (bwd, Phase 36)
# fp32 sibling of igemm_bwd_gtc_gfx1250_nhwc_fp16_ntail.config -- see that file and
# docs/gfx1250_wmma_layout.md's Phase 36 for the mechanism. Precision-generic code
# (data_byte-driven masking arithmetic); fp32's pre-existing M-tail-only config already
# validates this tile shape/precision combination works at all.
[igemm_bwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "bwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_n_tail              = 1
