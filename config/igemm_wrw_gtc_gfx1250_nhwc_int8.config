[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x64, correctness-first WMMA milestone
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. gemm_k_per_block=64 here (not 32) since v_wmma_i32_16x16x64_iu8 has K=64.
# See python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "int8"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
# NOTE: gemm_k_global_split is NOT set for int8 wrw, unlike fp16/bf16/fp32.
# The int8+gsplit path (global_atomic_add_u32 epilogue, Phase 57) is valid:y on
# 1x1 shapes at 128x128 with low split counts, but produces valid:n on 3x3 shapes
# and on the 64x64 tile (valid:n at 1x1 too). This is a pre-existing codegen issue
# never exposed before because no int8 config used gsplit. Debugging is tracked
# separately -- do not add gemm_k_global_split=1 to int8 configs until fixed.

#########################################################################################
#--------------------------- 64x64x64, small-tile coverage for non-128-aligned gemm_m/gemm_n
# See igemm_fwd_gtc_gfx1250_nhwc_fp16.config's 64x64 section for the full derivation.
# gemm_k_per_block=64 (not 32) since v_wmma_i32_16x16x64_iu8 has K=64.
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "int8"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
