[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, Phase 26b combined GEMM_M+N tail
# Both wmma_m_tail and wmma_n_tail set -- validates the two EXEC-mask guards chain
# correctly in one kernel. Kept in its own file (not combined with _mtail.config or
# _ntail.config's 128x128 section) since none of these flags are folded into the kernel
# name -- two sections of the same tile shape with different flag combos would collide on
# symbol name, same rationale as Phase 25's epilogue_lds_pad config-file precedent.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_m_tail              = 1
wmma_n_tail              = 1

direct_store             = 1
