[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x64, small-tile + widened-K variant
# Backlog item "widen wrw's tile-shape space": pairs the small 64x64 M/N tile with a
# larger gemm_k_per_block, mirroring CK's small-tile/large-KPerBlock pattern for
# small-output-channel wrw problems (fewer, cheaper main-loop iterations without forcing
# the 128x128 tile). gemm_k_per_block=64 is the CEILING this tile shape's CURRENT
# addressing mechanism supports, not an arbitrary choice: both A and B reuse the same
# `num_col_groups = gemm_m_per_block // gemm_k_per_block` thread-mapping
# (igemm_wrw_gtc_wmma_nhwc.py's emit_kernel_prologue -- both operands are "transposed",
# GEMM_K is the spatial axis, and A/B share identical col_group bit-slicing since wrw's
# tiles are always square). That requires gemm_m_per_block >= gemm_k_per_block, so for a
# 64-wide tile, gemm_k_per_block=64 (num_col_groups=1) is as far as this mechanism can go
# without a genuine addressing redesign -- CK's stated 96/128/256 range is NOT reachable
# here without one. See docs/gfx1250_optimization_backlog.md for the full writeup of why
# this backlog item's original wording ("K=96/128/256") turned out to be infeasible as
# literally stated.
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
