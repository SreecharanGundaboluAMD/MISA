[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x64, correctness-first WMMA milestone
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. gemm_k_per_block=64 here (not 32) since v_wmma_i32_16x16x64_iu8 has K=64.
# See python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.

#########################################################################################
# Master config: every validated fwd/int8 gfx1250 tunable combination from
# this project's individual mechanism config files, unioned into one file so a single
# conv_driver.exe build searches the FULL candidate set and reports the true fastest
# kernel per shape -- mirroring gfx950/942's single comprehensive per-direction/precision
# config file (see script/gen_gfx950_conv_split_kernel.sh). Generated by
# script/build_gfx1250_master_configs.py from 9 source files; re-run that
# script after adding a new gfx1250 config file to pick it up here too.
#########################################################################################

# --- from igemm_fwd_gtc_gfx1250_nhwc_int8.config ---
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "int8"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0

#########################################################################################
#--------------------------- 64x64x64, small-tile coverage for non-128-aligned gemm_m/gemm_n
# See igemm_fwd_gtc_gfx1250_nhwc_fp16.config's 64x64 section for the full derivation.
# gemm_k_per_block=64 (not 32) since v_wmma_i32_16x16x64_iu8 has K=64.

# --- from igemm_fwd_gtc_gfx1250_nhwc_int8.config ---
[igemm_fwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "int8"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0

# --- from igemm_fwd_gtc_gfx1250_nhwc_int8_128x64.config ---
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 64
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 2]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "int8"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0

# --- from igemm_fwd_gtc_gfx1250_nhwc_int8_64x128.config ---
[igemm_fwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 64, 1, 2]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "int8"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0

# --- from igemm_fwd_gtc_gfx1250_nhwc_int8_async.config ---
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
