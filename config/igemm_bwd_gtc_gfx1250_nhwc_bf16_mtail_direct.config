[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x32, Phase 26a GEMM_M tail (bwd)
# 64x64 ONLY -- the 128x128 tile's extra v_m_tail_row VGPR pushes bwd to 257/256, one over
# the hard wave32 VGPR limit (confirmed by codegen's own assembler-rejection: "register
# index is out of range"). bwd's non-tail 128x128 build is already at 256 with zero margin
# (see igemm_bwd_gtc_wmma_nhwc.py's _emit_lds_offset_setup docstring), so ANY extra
# persistent VGPR breaks it -- not something wmma_m_tail specifically could avoid. 64x64
# has enough headroom for the extra register. See docs/gfx1250_wmma_layout.md's Phase 26a.
[igemm_bwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "bwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_m_tail              = 1

direct_store             = 1
