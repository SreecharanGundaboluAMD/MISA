[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
# NOTE: no 128x128 section here -- combining all three tails (M+N+K) with
# gemm_k_global_split at 128x128 overflows the 256-VGPR hard limit by 1 (257 used), a real
# hardware ceiling, not a bug (each new tail flag costs ~1 VGPR, and 128x128's split-K
# build has essentially zero headroom to begin with -- same class of wall bwd's plain
# wmma_m_tail alone already hit at 128x128, see that phase's writeup). 64x64 has ample
# headroom (177/256) and is the only tile shape this fully-combined config ships at. Any
# TWO of the three tails combine fine at 128x128 (already validated separately). See
# docs/gfx1250_wmma_layout.md's Phase 35.
#--------------------------- 64x64x32, gemm_k_global_split + full M/N/K-tail relief
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
gemm_k_global_split      = 1
wmma_m_tail              = 1
wmma_n_tail              = 1
wmma_k_tail              = 1
