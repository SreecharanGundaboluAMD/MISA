[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 32x128x4, tile-coverage-gap follow-up (2026-09-07)
# docs/gfx1250_tile_coverage_gap.md: closes the fwd 32x128 gap entry. Single-wave
# (block_size=32) asymmetric tile -- see python/operations/wmma_mapping.py's matching
# ctrl_wmma_mapping_t(32, 128, ...) entry for the full wave/repeat derivation and the
# measured VGPR-budget rationale for whichever extra flags this file sets below.
# Needs wmma_acc_high_bank=1 + wmma_epilogue_chunked=1: without them this shape measures
# over the 256-VGPR/wave ceiling (a single-wave block's prologue/epilogue overhead does
# not shrink with fewer waves) despite a modest total_acc_c -- moving the accumulator to
# the second VGPR bank (Phase 54's mechanism, already hardware-validated for 256x256/
# 256x128) frees enough of the plain 0-255 range to fit.
# lds_double_buffer=1 is mandatory for every fp32 WMMA config (COR-001, see AGENTS.md's
# Known Issues) -- unrelated to this tile shape, carried over unconditionally.
# tensor_a/b_thread_lengths and _cluster_lengths are NOT read by the WMMA kernel's address
# generation for this row_repeat-only tile (block_size<=min(gemm_m,gemm_n)_per_block, no
# col_split_b) -- they only need to satisfy igemm_base.py's generic validation asserts
# (product(cluster)==block_size, product(thread)*block_size==gemm_{m,n}_per_block*gemm_k_per_block),
# same dead-weight convention as the existing 128x64/64x128 asymmetric configs.
[igemm_fwd_gtc]
gemm_m_per_block         = 32
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 8
tensor_a_thread_lengths  = [1, 1, 1, 4]
tensor_a_cluster_lengths = [1, 1, 1, 32]
tensor_b_thread_lengths  = [1, 1, 1, 16]
tensor_b_cluster_lengths = [1, 1, 1, 32]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
