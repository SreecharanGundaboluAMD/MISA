[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x128, row_stride addressing pilot (int8)
# int8's v_wmma_i32_16x16x64_iu8 has inst_wmma.k=64 (not 32 like fp16/bf16), so
# chunks_per_row = gemm_m_per_block(64)/64 = 1 -- each owned row is exactly one chunk.
# row_stride = 128/64 = 2. Single group, no split-K/streamk/TDM.
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 128
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 128, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 128, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "int8"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
