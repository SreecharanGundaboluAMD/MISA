# --- 128x128x4 +direct_store+ds_load_tr_b+epilogue_lds_pad+local_prefetch_num+wmma_n_tail ---
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
direct_store              = 1
wmma_n_tail               = 1
local_prefetch_num        = 1
epilogue_lds_pad          = 1
ds_load_tr_b              = 0
# REQUIRED for correctness, not a perf knob -- see docs/gfx1250_fp32_wmma_occupancy_race.md.
