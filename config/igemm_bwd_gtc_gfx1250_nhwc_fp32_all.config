tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
direct_store              = 1
wmma_m_tail               = 1
wmma_n_tail               = 1
wmma_setprio              = 1
local_prefetch_num        = 1
epilogue_lds_pad          = 1
saddr_global_load         = 1
ds_load_tr_b              = 0
wmma_gap_hoist            = 1
