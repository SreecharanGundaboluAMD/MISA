[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, gemm_k_global_split + Phase 41 launch stagger
# Identical to igemm_wrw_gtc_gfx1250_nhwc_bf16_gsplit.config except gsplit_stagger=1 --
# see docs/gfx1250_wmma_layout.md's Phase 41 and docs/gfx1250_optimization_backlog.md.
# MISA's own untested-in-hipconv hypothesis (searched hipconv's actual source across
# every wgrad/splitk branch, found no reference implementation): stagger each split-K
# shard's very first memory burst by (bz mod 128)*~64 cycles via S_SLEEP_VAR, to reduce
# same-relative-offset burst contention across concurrently-launched shards. Measured
# result (IGEMM_GSPLIT_SWEEP-pinned, controlled A/B, 3 repeats each): a small, consistent
# ~3-4% improvement at very high split counts (1260 splits, heavily over-subscribed
# occupancy) on the c=192,H=60,W=80,k=64 worst-case shape; within noise at moderate
# split counts (525); GPU-contention-dominated noise at low split counts (84), no
# reliable signal there. NOT folded into the master config union or any other config's
# default -- kept as its own opt-in file pending a clean re-measurement on an idle GPU.
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
gemm_k_global_split      = 1
gsplit_stagger           = 1

#########################################################################################
#--------------------------- 64x64x32 gemm_k_global_split + Phase 41 launch stagger
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
gemm_k_global_split      = 1
gsplit_stagger           = 1
