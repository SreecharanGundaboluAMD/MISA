[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x4, Phase 26a GEMM_M tail (bwd)
# 64x64 ONLY -- see igemm_bwd_gtc_gfx1250_nhwc_bf16_mtail.config's header comment (128x128
# blows the 256-VGPR/wave limit by 1 register once wmma_m_tail's v_m_tail_row is added).
# gemm_k_per_block=4 since v_wmma_f32_16x16x4_f32 has K=4.
[igemm_bwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "bwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_m_tail              = 1
