[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, Phase 13: global_load_async_to_lds_b128 (A only)
# Identical to the 128x128 config in igemm_bwd_gtc_gfx1250_nhwc_fp16.config except
# async_global_load=1 -- bwd's A (grad_output) goes async; B stays on the existing
# transposed read-and-pack technique (out of scope). Separate file for the same
# kernel-name-collision reason as fwd's _async configs.
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
async_global_load        = 1
