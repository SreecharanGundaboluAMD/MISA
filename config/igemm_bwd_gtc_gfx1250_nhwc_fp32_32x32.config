[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 32x32x4, occupancy tile for small-gemm_m/n shapes
# fp32 analog of igemm_bwd_gtc_gfx1250_nhwc_bf16_32x32.config -- gemm_k_per_block=4 (not
# 32) since v_wmma_f32_16x16x4_f32 has K=4, matching this project's existing fp32 tile
# convention (see igemm_bwd_gtc_gfx1250_nhwc_fp32.config's own 64x64/128x128 sections).
# See that file and docs/gfx1250_wmma_layout.md's Phase 46 for the full derivation.
[igemm_bwd_gtc]
gemm_m_per_block         = 32
gemm_n_per_block         = 32
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 2
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 32]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 32]
direction                = "bwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
