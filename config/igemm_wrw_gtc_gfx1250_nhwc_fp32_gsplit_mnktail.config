[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
# NOTE: no 128x128 section here -- see igemm_wrw_gtc_gfx1250_nhwc_bf16_gsplit_mnktail.config's
# header comment (combining all three tails with gemm_k_global_split at 128x128 overflows
# the 256-VGPR hard limit). 64x64 has ample headroom and is the only tile shape this
# fully-combined config ships at. See docs/gfx1250_wmma_layout.md's Phase 35.
#--------------------------- 64x64x4, gemm_k_global_split + full M/N/K-tail relief (fp32)
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
gemm_k_global_split      = 1
wmma_m_tail              = 1
wmma_n_tail              = 1
wmma_k_tail              = 1
lds_double_buffer        = 1
