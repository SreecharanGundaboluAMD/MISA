[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x128x32, wr8x4-w4 + GEMM_M tail (2026-09-02) -----------
# Same tile/tunables as `_256x128_wr8x4w4.config` (existing ctrl_wmma_mapping_table
# 'bf16' 256x128 entry, 4 waves, wave_repeat_m=8/wave_repeat_n=4, requires
# wmma_acc_high_bank=1 + wmma_epilogue_chunked=1) with wmma_m_tail=1 added, mirroring
# `_256x256_mtail.config`'s identical Phase 68 derivation (tail composes cleanly with
# chunked+high_bank, hardware-validated there). Without this, the 256x128 tile was only
# reachable when gemm_m (=n*ho*wo for fwd's NHWC layout) divided evenly by 256 -- which
# turns out to EXCLUDE most of the MIOpen-comparison benchmark's real-world shapes with
# gemm_n=128 (output channels=128): e.g. n42 c256 h30w40 k128 has gemm_m=42*30*40=50400,
# 50400%256=224, previously REJECTED outright despite gemm_n=128 being an EXACT fit for
# this tile's N dimension. gemm_n itself is never tailed here (wmma_n_tail not set) --
# only needed if gemm_n also doesn't divide 128 evenly, kept out to isolate this change.
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 8
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 2]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
wmma_m_tail              = 1
