[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x128x32, Phase 53 chunked epilogue -- bwd's version of
# fwd's 256x256 entry (see that file's comment for the full Phase 52/53 derivation).
# Asymmetric here (not 256x256) because bwd's B (weight) operand is TRANSPOSED
# (igemm_bwd_gtc_wmma_nhwc.py's own docstring) and asserts row_repeat_b==1 -- gemm_n_
# per_block must stay == block_size(128), so only gemm_m_per_block grows (wave_repeat_m
# 4->8, row_repeat_a=2, already-generalized). Still a real win: half fwd's area gain
# (2x not 4x vs. the 128x128 baseline), but its main-loop A+B LDS
# (256*32*2 + 128*32*2 = 24576 bytes) leaves enough headroom to stay comfortably
# single-buffered (this project's own config default) with room to spare. Requires
# wmma_epilogue_chunked=1. Only supports the degenerate case: 1x1 filter, stride 1, no
# padding (nxe=0). See docs/gfx1250_wmma_layout.md's Phase 52/53.
[igemm_bwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 8
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 2]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_bf16            = 1
wmma_epilogue_chunked    = 1
