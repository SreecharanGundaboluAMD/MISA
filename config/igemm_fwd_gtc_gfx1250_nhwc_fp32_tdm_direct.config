[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x4, Phase 28: TDM-based A-operand load pilot
# gemm_k_per_block=4 since v_wmma_f32_16x16x4_f32 has K=4 (see the base fp32 config).
# Identical to the 128x128 config in igemm_fwd_gtc_gfx1250_nhwc_fp32.config except
# tdm_global_load=1. See docs/gfx1250_wmma_layout.md's Phase 28.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
tdm_global_load          = 1

direct_store             = 1
