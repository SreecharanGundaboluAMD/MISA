[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x256x32, packed-accumulate variant of the plain 256x256
# entry (Phase 56) -- combines wmma_acc_bf16 (halves v_c to 128 registers) with
# wmma_acc_high_bank, dropping total wave VGPR need from 512 to 384. Measured ~10% faster
# than the plain (full F32) 256x256 entry across small/medium/large same-run comparisons,
# but STILL ~2x slower than the existing 128x128 kernel in every shape tried -- occupancy
# recovery from the VGPR reduction alone isn't enough to close that gap. Kept as a
# separate opt-in config file (not folded into the plain entry, and NOT unioned into the
# master _all.config -- wmma_acc_bf16 is one of `build_gfx1250_master_configs.py`'s
# ACCUMULATE_WIDTH_KEYS, excluded because conv_driver.cpp computes the output buffer
# width once from the FIRST kernel in a search, silently corrupting verification for any
# differently-widthed kernel mixed into the same run -- same reason every other
# `*_bf16acc.config`/`*_f16acc.config` file in this repo stays separate). See
# docs/gfx1250_wmma_vgpr_msb_wip_status.md's Phase 56 for the full investigation.
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 256
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 8
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 256]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 256]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_acc_bf16            = 1
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
