[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x4, Phase 13: global_load_async_to_lds_b128
# Identical to the 128x128 config in igemm_fwd_gtc_gfx1250_nhwc_fp32.config except
# async_global_load=1 -- see igemm_fwd_gtc_gfx1250_nhwc_fp16_async.config's comment for
# why this needs a separate file (kernel-name mangling doesn't fold this tunable in).
# gemm_k_per_block=4 (not 32/64) since v_wmma_f32_16x16x4_f32 has K=4 -- num_k_chunks==1
# here (chunk_num_dwordx4 == num_dwordx4 == 1), the smallest possible async-chunk case.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
async_global_load        = 1
lds_double_buffer        = 1
