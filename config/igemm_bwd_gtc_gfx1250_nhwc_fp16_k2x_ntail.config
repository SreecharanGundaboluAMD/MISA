[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x64, GEMM_N tail + k-sub-loop (num_k_chunks=2) combined
# Smoke test for N-tail's multi-chunk masking path (_emit_sst_all_chunks's per-chunk
# elements_before offset) -- every other N-tail config so far has gemm_k_per_block==
# inst_wmma.k (num_k_chunks=1), never exercising the >1 case.
[igemm_bwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_n_tail              = 1
