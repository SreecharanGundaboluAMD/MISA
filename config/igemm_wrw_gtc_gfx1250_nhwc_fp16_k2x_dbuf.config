# Phase 2 (LDS double-buffering) combined with Phase 1's k-sub-loop: doubles the
# (already-bumped) LDS allocation. See docs/gfx1250_wmma_layout.md.
# Phase 1 (k-sub-loop): gemm_k_per_block = 64 = 32*(num_k_substeps) -- multiple v_wmma_*
# issues per LDS round-trip (amortizes barrier/global-load-store overhead). See
# python/operations/wmma_main_loop.py's k-sub-loop docstring / docs/gfx1250_wmma_layout.md.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x64, k-sub-loop variant (see banner above)
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. See python/igemm/igemm_wrw_gtc_wmma_nhwc.py for the full explanation.
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
