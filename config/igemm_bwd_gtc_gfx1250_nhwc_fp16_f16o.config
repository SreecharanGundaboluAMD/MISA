# wmma_fp16_output = 1 -- see igemm_fwd_gtc_gfx1250_nhwc_fp16_f16o.config's header comment
# for the full mechanism/rationale (identical across directions). NOT unioned into the
# master _all.config for the same reason wmma_acc_f16/bf16/atomic_pack_bf16 aren't --
# conv_driver.cpp computes is_wmma_fp16_output ONCE from tunables[0].
#
# No 128x128x32 section here (unlike fwd/wrw's identical file): bwd's 128x128 tile is
# ALREADY at the hard 256-VGPR/wave limit with zero headroom in its plain (no
# wmma_fp16_output) build (v_end=256, confirmed via igemm_codegen.py -- see also Phase 23's
# identical LDS-side observation for this exact tile). Adding wmma_fp16_output's extra
# v_fp16o_partner register overflows to v_end=258, a genuine "register index is out of
# range" assembler failure, not a code bug -- bwd's 128x128 tile structurally cannot fit
# this mechanism without freeing VGPR budget elsewhere first (out of scope here). 64x64
# has headroom and builds/validates fine.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x32, small-tile coverage for non-128-aligned gemm_m/gemm_n
[igemm_bwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_fp16_output         = 1
