[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
# Master config: all valid tunable combos for bwd/fp16 128x128x32
# Generated by script/generate_all_configs.py
# 44 combinatorial variants
#########################################################################################

# --- 128x128x32 +local_prefetch_num ---
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
local_prefetch_num        = 1
#########################################################################################
#--------------------------- 64x64x32, small-tile coverage for non-128-aligned gemm_m/gemm_n
# Ported from igemm_fwd_gtc_gfx1250_nhwc_fp16.config's 64x64 section -- see that file's
# comment for the full derivation (block_size=64 via asymmetric wave grid
# waves_per_m=2/waves_per_n=1, since wave_tile is fixed at 16 and a 64x64 macro tile can't
# reach block_size=64 any other way).

# --- 128x128x32 +local_prefetch_num+wmma_setprio ---
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
