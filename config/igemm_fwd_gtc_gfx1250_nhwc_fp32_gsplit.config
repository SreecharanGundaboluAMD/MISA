[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x4, gemm_k_global_split (K-split across grid.z,
# atomic-add accumulation into output) -- gemm_k_per_block=4 since v_wmma_f32_16x16x4_f32
# has K=4, matching this project's existing fp32 tile convention. See
# python/igemm/igemm_fwd_gtc_wmma_nhwc.py and docs/gfx1250_wmma_layout.md's Phase 49. Not
# combined with wmma_k_tail, tdm_global_load, async_global_load, or main_loop_interleave in
# this initial pass (all asserted against). NOTE: as with bwd's Phase 48 fp32 finding,
# fp32's gemm_k_per_block=4 is much finer-grained than bf16/fp16's 32, so the driver's
# ~512-total-workgroups heuristic tends to over-split for fp32 -- use IGEMM_GSPLIT_SWEEP to
# hand-tune if the default split count underperforms.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
gemm_k_global_split      = 1
lds_double_buffer        = 1

#########################################################################################
#--------------------------- 64x64x4 gemm_k_global_split
[igemm_fwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
gemm_k_global_split      = 1
lds_double_buffer        = 1
