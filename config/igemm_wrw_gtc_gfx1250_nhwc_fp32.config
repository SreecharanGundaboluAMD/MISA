[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x4, correctness-first WMMA milestone
# gemm_k_per_block=4 here (not 32/64) since v_wmma_f32_16x16x4_f32 has K=4 -- see
# python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
# REQUIRED for correctness, not a perf knob -- see docs/gfx1250_fp32_wmma_occupancy_race.md.
# Single-buffered LDS with v_wmma_f32_16x16x4_f32 (this arch's only pure-fp32 WMMA form)
# produces silent wrong-answer results once enough workgroups are concurrently resident --
# confirmed on fwd/bwd at scale (>1500-10k workgroups depending on tile size); wrw shares
# the identical wmma_main_loop.py code path and opcode, so it is presumed equally exposed
# and gets the same mitigation proactively (not independently stress-tested at the same
# occupancy scale -- wrw's grid size is driven by k/c, not n, so reproducing the fwd/bwd
# repro shape doesn't directly carry over; see the doc for how to scale wrw's grid if this
# needs re-verifying). Confirmed NOT a barrier/LDS-fence issue and NOT fixable by V_NOP or
# s_setprio spacing for fwd/bwd. Do not remove without re-validating at high occupancy.
gemm_k_global_split      = 1

#########################################################################################
#--------------------------- 64x64x4, small-tile coverage for non-128-aligned gemm_m/gemm_n
# See igemm_fwd_gtc_gfx1250_nhwc_fp16.config's 64x64 section for the full derivation.
# gemm_k_per_block=4 since v_wmma_f32_16x16x4_f32 has K=4.
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
# REQUIRED for correctness -- see the 128x128 section above and
# docs/gfx1250_fp32_wmma_occupancy_race.md.
gemm_k_global_split      = 1
