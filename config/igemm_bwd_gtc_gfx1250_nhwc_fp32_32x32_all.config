tensor_b_cluster_lengths = [1, 1, 1, 32]
direction                = "bwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
local_prefetch_num        = 1
ds_load_tr_b              = 0

