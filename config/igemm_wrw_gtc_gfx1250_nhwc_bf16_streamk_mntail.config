[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x32, wrw_streamk + Phase 35 M/N-tail relief -- only
# 64x64 (not 128x128): the 128x128 tile is already at gfx1250's 256-VGPR wall with
# wrw_streamk's own claim/broadcast scratch (v_streamk_one/claim/zero) alone (see
# docs/gfx1250_streamk_design.md); adding wmma_m_tail/wmma_n_tail's own 2 registers on top
# overflows it (confirmed: codegen emits register index 258, out of the 0-255 range).
# 64x64's much smaller accumulator footprint has headroom for both. Hardware-validated:
# M-only tail, N-only tail, both together, and combined with genuine multi-claim (large K)
# all pass valid:y.
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
gemm_k_global_split      = 1
wrw_streamk              = 1
wmma_m_tail              = 1
wmma_n_tail              = 1
