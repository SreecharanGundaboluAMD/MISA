# Phase 35 (tile widening): gemm_k_per_block = 128 = 32*4 (num_k_substeps=4) -- CK's WMMA
# instance library spans KPerBlock up to 256 for exactly this reason (small-M/N-huge-K wrw
# problems get fewer, cheaper main-loop iterations without forcing a bigger tile). See
# docs/gfx1250_wmma_layout.md's Phase 35 and docs/gfx1250_ck_deep_dive.md.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x128, k-sub-loop widened to 4 substeps
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. See python/igemm/igemm_wrw_gtc_wmma_nhwc.py for the full explanation.
[igemm_wrw_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 128
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 128, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 128, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "wrw"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
