# Phase 15 (main-loop interleaving): gemm_k_per_block = 64 = 32*2 (Phase 1's k-sub-loop,
# required -- interleaving needs num_k_substeps > 1 to have anything to interleave), plus
# main_loop_interleave=1. Each remaining chunk's global load is issued right before the
# PREVIOUS chunk/substep's compute, instead of loading+storing every remaining chunk
# sequentially after all compute is done -- see wmma_main_loop.py's ctrl.interleave
# docstring and docs/gfx1250_wmma_layout.md's Phase 15 section.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x64, main-loop interleaving variant (see banner above)
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. See python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 64
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 64, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 64, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
main_loop_interleave     = 1
