[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 32x32x32, occupancy tile for small-gemm_m/n shapes
# Added to close a real gap found benchmarking MISA against CK on a small-spatial/
# large-channel bwd shape (n=4,c=512,H=W=8,k=256,1x3): gemm_m=n*hi*wi=256, gemm_n=c=512,
# both too small for 64x64 to produce enough workgroups on gfx1250's 256 CUs (64x64 gives
# only ceil(256/64)*ceil(512/64)=32 workgroups; 32x32 gives ceil(256/32)*ceil(512/32)=128).
# Single wave (block_size=32=gemm_m_per_block=gemm_n_per_block exactly), the same
# structural category as the existing 64x64/128x128 entries -- no row_repeat_a/b
# generalization needed. See python/operations/wmma_mapping.py's table-level comment and
# docs/gfx1250_wmma_layout.md's Phase 46 for the full derivation and hardware validation.
[igemm_bwd_gtc]
gemm_m_per_block         = 32
gemm_n_per_block         = 32
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 2
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 32]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 32]
direction                = "bwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
