[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x4, correctness-first WMMA milestone
# gemm_k_per_block=4 here (not 32/64) since v_wmma_f32_16x16x4_f32 has K=4 -- see
# python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.
[igemm_bwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "bwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
# REQUIRED for correctness, not a perf knob -- see docs/gfx1250_fp32_wmma_occupancy_race.md.
# Single-buffered LDS with v_wmma_f32_16x16x4_f32 (this arch's only pure-fp32 WMMA form)
# produces silent wrong-answer results once enough workgroups are concurrently resident
# (empirically: valid:y below ~1500 total workgroups, flaky-to-always-wrong above).
# Confirmed NOT a barrier/LDS-fence issue and NOT fixable by V_NOP or s_setprio spacing
# (both tested, both had zero effect) -- root cause is unconfirmed, needs hardware-level
# tracing. Affects fwd/bwd/wrw alike, both 64x64 and 128x128 tiles alike -- do not remove
# this on any fp32 gemm_k_per_block=4 config without re-validating at >1500 workgroups.

#########################################################################################
#--------------------------- 64x64x4, small-tile coverage for non-128-aligned gemm_m/gemm_n
# See igemm_fwd_gtc_gfx1250_nhwc_fp16.config's 64x64 section for the full derivation.
# gemm_k_per_block=4 since v_wmma_f32_16x16x4_f32 has K=4.
[igemm_bwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "bwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
# REQUIRED for correctness -- see the 128x128 section above and
# docs/gfx1250_fp32_wmma_occupancy_race.md. This tile hits the failure threshold at a much
# smaller n (~1500 total workgroups) than 128x128 does, since its smaller LDS/VGPR
# footprint allows higher occupancy per WGP -- it is NOT more "broken" than 128x128, just
# easier to trigger.
