[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 256x128x4, PERF-003 extension (2026-09-02) ----------------
# Mechanical port of igemm_bwd_gtc_gfx1250_nhwc_bf16_256x128.config's 256x128 entry to
# fwd -- fwd's row_repeat_a/b mechanism is already fully generic (see
# igemm_fwd_gtc_wmma_nhwc.py's __init__ docstring), so no bwd-specific transposed-B
# constraint applies here. waves=4 (block_size=128), wave_repeat_m=8/wave_repeat_n=4 ->
# gemm_m_per_block(256) is 2x block_size (row_repeat_a=2, thread_lengths[3]=2 below),
# gemm_n_per_block(128)==block_size exactly (row_repeat_b=1). Same
# wmma_acc_high_bank=1/wmma_epilogue_chunked=1 requirement as the 256x256 entry --
# total_acc_c = 8*4*8 = 256. lds_double_buffer=1 is REQUIRED for fp32 WMMA correctness
# regardless of tile size -- see igemm_fwd_gtc_gfx1250_nhwc_fp32_128x128_all.config's
# identical note. gemm_k_per_block=4 since v_wmma_f32_16x16x4_f32 has K=4.
[igemm_fwd_gtc]
gemm_m_per_block         = 256
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 8
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 2]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
lds_double_buffer        = 1
wmma_acc_high_bank       = 1
wmma_epilogue_chunked    = 1
