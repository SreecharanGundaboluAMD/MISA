[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x4, GEMM_M+N+K tail combined (fwd, Phase 38)
# Combines the new non-TDM K-tail with the existing wmma_m_tail/wmma_n_tail EXEC-mask
# mechanisms -- independent, composable (K-tail's post-load AND-mask on top of M/N-tail's
# whole-lane EXEC zero-fill just stays zero). See docs/gfx1250_wmma_layout.md's Phase 38.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 4
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 4, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 4, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp32"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_m_tail              = 1
wmma_n_tail              = 1
wmma_k_tail              = 1
