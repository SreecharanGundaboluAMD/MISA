# wmma_fp16_output = 1 -- converts the f32 accumulator to packed fp16x2 at store time
# (v_cvt_pk_f16_f32 in the direct_store epilogue, v_cvt_f16_f32+ds_write_b16 in the
# default LDS-reshuffle epilogue), halving output store bytes/instructions vs writing
# f32. The accumulator itself stays f32 (unlike wmma_acc_f16, which changes the WMMA
# instruction's D-operand width) -- only the store narrows. Validated 1.087-1.145x
# (perf report 2026-09-06 R2) with zero regressions, but previously reachable from 0
# configs. Mutually exclusive with gemm_k_global_split (no packed-fp16 atomic-add on
# this ISA) and wmma_acc_f16/wmma_acc_bf16/atomic_pack_bf16 (already produce 2-byte
# output natively) -- see python/igemm/igemm_base.py's assert block. Folded into
# kernel name as "_f16o" so plain and fp16-output variants of the same tile shape can
# coexist. NOT unioned into the master _all.config (build_gfx1250_master_configs.py's
# ACCUMULATE_WIDTH_KEYS): conv_driver.cpp computes is_wmma_fp16_output ONCE from
# tunables[0], not per-tunable, so mixing this into a file whose first section doesn't
# share this output width would silently corrupt verification for it -- same hazard as
# wmma_acc_f16/wmma_acc_bf16/atomic_pack_bf16, which get the identical exclusion.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, correctness-first WMMA milestone
# Only supports the degenerate case: 1x1 filter, stride 1, no padding (nxe=0), i.e. a
# plain GEMM. See python/igemm/igemm_fwd_gtc_wmma_nhwc.py for the full explanation.
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_fp16_output         = 1

#########################################################################################
#--------------------------- 64x64x32, small-tile coverage for non-128-aligned gemm_m/gemm_n
# Same 1x1/stride1/no-pad (nxe=0) restriction as the 128x128 config above.
[igemm_fwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_fp16_output         = 1
