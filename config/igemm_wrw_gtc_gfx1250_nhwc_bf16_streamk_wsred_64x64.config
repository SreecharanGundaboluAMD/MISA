[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

# Phase 58 Approach C: wrw_streamk + wrw_reduction_kernel combined.
# The persistent-kernel loop uses s_streamk_tile_idx (not static s_bz) to compute the
# workspace-shard offset per-iteration; the non-atomic epilogue writes partial sums to
# disjoint workspace slices; the reduction kernel sums them afterward. This is the
# combination that could plausibly beat wsred on both predictability (streamk's
# demonstrated strength) AND throughput (wsred's demonstrated strength).
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
gemm_k_global_split      = 1
wrw_streamk              = 1
wrw_reduction_kernel     = 1