# --- 128x128x32 +direct_store+lds_double_buffer+local_prefetch_num+tdm_global_load+wmma_m_tail+wmma_n_tail+wmma_setprio ---
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
direct_store              = 1
wmma_m_tail               = 1
wmma_n_tail               = 1
tdm_global_load           = 1
lds_double_buffer         = 1
wmma_setprio              = 1
local_prefetch_num        = 1
#########################################################################################
#--------------------------- 64x64x32, small-tile coverage for non-128-aligned gemm_m/gemm_n
# See igemm_fwd_gtc_gfx1250_nhwc_fp16.config's 64x64 section for the full derivation.

