# Phase 23: epilogue_lds_pad=1 -- pads the non-atomic LDS-reshuffle epilogue's row stride by
# 4 elements (one dwordx4) to break a bank-conflict periodicity (macro_tile_n is always a
# multiple of 64, the LDS bank count, so the unpadded layout puts every row of a given column
# in the same bank). See docs/gfx1250_wmma_layout.md's Phase 23 and
# python/operations/coalescing_store_wmma.py.
#
# NOT set on the 128x128 section below: that tile is already exactly at the 64KB/workgroup
# LDS limit with zero headroom (Phase 21); padding it overflows to 67584 bytes, and
# get_kernel_code() asserts loudly rather than silently generating an unloadable kernel.
# Only 64x64 (and the asymmetric 128x64/64x128 shapes, not included here) have room.
[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 128x128x32, correctness-first WMMA milestone (unpadded --
# see banner above for why)
[igemm_fwd_gtc]
gemm_m_per_block         = 128
gemm_n_per_block         = 128
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 4
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 128]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 128]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0

#########################################################################################
#--------------------------- 64x64x32, small-tile coverage + LDS pad
[igemm_fwd_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 32
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 32, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 32, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "fwd"
precision                = "bf16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
epilogue_lds_pad         = 1
