[codegen]
arch = 'gfx1250'
code_object = 'cov3'
mode = 'flat'

#########################################################################################
#--------------------------- 64x64x128, row_stride addressing + K-tail
# identical to igemm_wrw_gtc_gfx1250_nhwc_fp16_64x64_k128.config except wmma_k_tail=1.
# Exercises _emit_a_kflag's row_stride>1 per-row-offset loop (K-tail is fine-grained,
# recomputed every main-loop iteration, unlike M/N-tail) -- see
# docs/gfx1250_wrw_addressing_redesign.md.
[igemm_wrw_gtc]
gemm_m_per_block         = 64
gemm_n_per_block         = 64
gemm_k_per_block         = 128
wmma_tile_m              = 16
wmma_repeat_m            = 2
wmma_tile_n              = 16
wmma_repeat_n            = 4
tensor_a_thread_lengths  = [1, 128, 1, 1]
tensor_a_cluster_lengths = [1, 1, 1, 64]
tensor_b_thread_lengths  = [1, 128, 1, 1]
tensor_b_cluster_lengths = [1, 1, 1, 64]
direction                = "wrw"
precision                = "fp16"
tensor_layout            = 'nhwc'
nxb                      = 0
nxe                      = 0
wavefront_size           = 32
cumode                   = 0
wmma_k_tail              = 1
